# From Dev Dashboard → your app → Settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Your store's myshopify domain (only this store is accepted)
SHOPIFY_SHOP=your-store.myshopify.com

# Optional
# SHOPIFY_API_VERSION=2026-10
# SHIPPING_PRICE=0            # e.g. 30 to add a 30 MAD "Livraison" line to every order
# SHIPPING_TITLE=Livraison
# INVENTORY_BEHAVIOUR=DECREMENT_OBEYING_POLICY   # or BYPASS / DECREMENT_IGNORING_POLICY
